<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>hydra</string>
	<key>scopeName</key>
	<string>source.hydra</string>
	<key>fileTypes</key>
	<array>
		<string>hy</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comment</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#module</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#import</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#definition</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#escapedName</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#string</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#literalType</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constructor</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keyword</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#termLiteral</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#number</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operator</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#typeReference</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#fieldName</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comment</key>
		<dict>
			<key>name</key>
			<string>comment.line.number-sign.hydra</string>
			<key>match</key>
			<string>#.*$</string>
		</dict>
		<key>module</key>
		<dict>
			<key>match</key>
			<string>^\s*(module)\s+([A-Za-z][A-Za-z0-9]*(?:\.[A-Za-z][A-Za-z0-9]*)*)</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.control.hydra</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>entity.name.namespace.hydra</string>
				</dict>
			</dict>
		</dict>
		<key>import</key>
		<dict>
			<key>match</key>
			<string>^\s*(import)\s+([A-Za-z][A-Za-z0-9]*(?:\.[A-Za-z][A-Za-z0-9]*)*)(?:\s+(as)\s+([A-Za-z][A-Za-z0-9]*))?</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.control.hydra</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>entity.name.namespace.hydra</string>
				</dict>
				<key>3</key>
				<dict>
					<key>name</key>
					<string>keyword.control.hydra</string>
				</dict>
				<key>4</key>
				<dict>
					<key>name</key>
					<string>variable.other.namespace.hydra</string>
				</dict>
			</dict>
		</dict>
		<key>definition</key>
		<dict>
			<key>match</key>
			<string>^([A-Za-z][A-Za-z0-9]*)\s*(:=)</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>entity.name.type.hydra</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.hydra</string>
				</dict>
			</dict>
		</dict>
		<key>escapedName</key>
		<dict>
			<key>name</key>
			<string>entity.name.type.escaped.hydra</string>
			<key>begin</key>
			<string>`</string>
			<key>end</key>
			<string>`</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.hydra</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
			</array>
		</dict>
		<key>string</key>
		<dict>
			<key>name</key>
			<string>string.quoted.double.hydra</string>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.character.escape.hydra</string>
					<key>match</key>
					<string>\\.</string>
				</dict>
			</array>
		</dict>
		<key>literalType</key>
		<dict>
			<key>name</key>
			<string>storage.type.primitive.hydra</string>
			<key>match</key>
			<string>\b(bigint|binary|boolean|decimal|float32|float64|int8|int16|int32|int64|string|uint8|uint16|uint32|uint64|unit|void)\b</string>
		</dict>
		<key>constructor</key>
		<dict>
			<key>name</key>
			<string>storage.type.hydra</string>
			<key>match</key>
			<string>\b(effect|either|list|map|optional|record|set|union|wrap)\b</string>
		</dict>
		<key>keyword</key>
		<dict>
			<key>name</key>
			<string>keyword.control.hydra</string>
			<key>match</key>
			<string>\b(case|forall|in|inject|let|project|unwrap)\b</string>
		</dict>
		<key>termLiteral</key>
		<dict>
			<key>name</key>
			<string>constant.language.hydra</string>
			<key>match</key>
			<string>\b(false|given|Infinity|left|NaN|none|right|true)\b|(?&lt;![A-Za-z0-9])_(?![A-Za-z0-9])</string>
		</dict>
		<key>number</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)(:)(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|binary)\b</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>constant.numeric.hydra</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>keyword.operator.ascription.hydra</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>storage.type.primitive.hydra</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.hydra</string>
					<key>match</key>
					<string>\b-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?\b</string>
				</dict>
			</array>
		</dict>
		<key>operator</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.hydra</string>
					<key>match</key>
					<string>:=</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.arrow.hydra</string>
					<key>match</key>
					<string>→|⇒</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.lambda.hydra</string>
					<key>match</key>
					<string>λ|Λ|∀</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.annotation.hydra</string>
					<key>match</key>
					<string>@</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.typeapplication.hydra</string>
					<key>match</key>
					<string>⟨|⟩</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.ascription.hydra</string>
					<key>match</key>
					<string>:</string>
				</dict>
				<dict>
					<key>name</key>
					<string>keyword.operator.assignment.field.hydra</string>
					<key>match</key>
					<string>=</string>
				</dict>
			</array>
		</dict>
		<key>typeReference</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b([a-z][A-Za-z0-9]*)(\.)([A-Z][A-Za-z0-9]*)\b</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>variable.other.namespace.hydra</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>punctuation.accessor.hydra</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.hydra</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>name</key>
					<string>entity.name.type.hydra</string>
					<key>match</key>
					<string>\b[A-Z][A-Za-z0-9]*\b</string>
				</dict>
			</array>
		</dict>
		<key>fieldName</key>
		<dict>
			<key>match</key>
			<string>\b([a-z][A-Za-z0-9]*)\s*(?=:)</string>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>variable.other.key.hydra</string>
				</dict>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
