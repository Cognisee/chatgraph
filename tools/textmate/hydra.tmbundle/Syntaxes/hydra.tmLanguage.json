{
  "name": "Hydra",
  "scopeName": "source.hydra",
  "fileTypes": ["hy"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#module" },
    { "include": "#import" },
    { "include": "#definition" },
    { "include": "#escapedName" },
    { "include": "#string" },
    { "include": "#literalType" },
    { "include": "#constructor" },
    { "include": "#keyword" },
    { "include": "#termLiteral" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#typeReference" },
    { "include": "#fieldName" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.hydra",
      "match": "#.*$"
    },

    "module": {
      "match": "^\\s*(module)\\s+([A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*)",
      "captures": {
        "1": { "name": "keyword.control.module.hydra" },
        "2": { "name": "entity.name.namespace.hydra" }
      }
    },

    "import": {
      "match": "^\\s*(import)\\s+([A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*)(?:\\s+(as)\\s+([A-Za-z][A-Za-z0-9]*))?",
      "captures": {
        "1": { "name": "keyword.control.import.hydra" },
        "2": { "name": "entity.name.namespace.hydra" },
        "3": { "name": "keyword.control.import.hydra" },
        "4": { "name": "entity.name.namespace.alias.hydra" }
      }
    },

    "definition": {
      "comment": "A name bound at the left margin: the thing being defined.",
      "match": "^([A-Za-z][A-Za-z0-9]*)\\s*(:=)",
      "captures": {
        "1": { "name": "entity.name.type.hydra" },
        "2": { "name": "keyword.operator.assignment.hydra" }
      }
    },

    "escapedName": {
      "comment": "Backtick-escaped names admit anything, including dots in binder heads.",
      "name": "entity.name.type.escaped.hydra",
      "begin": "`",
      "end": "`",
      "patterns": [{ "name": "constant.character.escape.hydra", "match": "\\\\." }]
    },

    "string": {
      "name": "string.quoted.double.hydra",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.hydra", "match": "\\\\." }]
    },

    "literalType": {
      "comment": "Primitive types, from the reserved-word list in the spec.",
      "name": "support.type.primitive.hydra",
      "match": "\\b(bigint|binary|boolean|decimal|float32|float64|int8|int16|int32|int64|string|uint8|uint16|uint32|uint64|unit|void)\\b"
    },

    "constructor": {
      "comment": "Type constructors that take arguments or a brace body.",
      "name": "support.type.constructor.hydra",
      "match": "\\b(effect|either|list|map|optional|record|set|union|wrap)\\b"
    },

    "keyword": {
      "name": "keyword.control.hydra",
      "match": "\\b(case|forall|in|inject|let|project|unwrap)\\b"
    },

    "termLiteral": {
      "comment": "Term-level constants, including the float specials.",
      "name": "constant.language.hydra",
      "match": "\\b(false|given|Infinity|left|NaN|none|right|true)\\b|(?<![A-Za-z0-9])_(?![A-Za-z0-9])"
    },

    "number": {
      "comment": "Integers and floats carry a width suffix; a bare number is a decimal.",
      "patterns": [
        {
          "name": "constant.numeric.suffixed.hydra",
          "match": "\\b(-?\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?)(:)(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|binary)\\b",
          "captures": {
            "1": { "name": "constant.numeric.hydra" },
            "2": { "name": "keyword.operator.ascription.hydra" },
            "3": { "name": "support.type.primitive.hydra" }
          }
        },
        {
          "name": "constant.numeric.decimal.hydra",
          "match": "\\b-?\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?\\b"
        }
      ]
    },

    "operator": {
      "patterns": [
        { "name": "keyword.operator.assignment.hydra", "match": ":=" },
        { "name": "keyword.operator.arrow.hydra", "match": "→|⇒" },
        { "name": "keyword.operator.lambda.hydra", "match": "λ|Λ|∀" },
        { "name": "keyword.operator.annotation.hydra", "match": "@" },
        { "name": "keyword.operator.typeapplication.hydra", "match": "⟨|⟩" },
        { "name": "keyword.operator.ascription.hydra", "match": ":" },
        { "name": "keyword.operator.assignment.field.hydra", "match": "=" }
      ]
    },

    "typeReference": {
      "comment": "A qualified reference, e.g. units.Length: the namespace alias and the type read differently.",
      "patterns": [
        {
          "match": "\\b([a-z][A-Za-z0-9]*)(\\.)([A-Z][A-Za-z0-9]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.alias.hydra" },
            "2": { "name": "punctuation.accessor.hydra" },
            "3": { "name": "entity.name.type.reference.hydra" }
          }
        },
        {
          "name": "entity.name.type.reference.hydra",
          "match": "\\b[A-Z][A-Za-z0-9]*\\b"
        }
      ]
    },

    "fieldName": {
      "comment": "A lowercase name immediately before a colon: a record field or union variant.",
      "match": "\\b([a-z][A-Za-z0-9]*)\\s*(?=:)",
      "captures": { "1": { "name": "variable.other.member.hydra" } }
    }
  }
}
