# API keys (required). See the "Accounts and services" section of
# README.md for where to obtain each.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Optional: override the Claude model used for the conversational agent.
CHATGRAPH_AGENT_MODEL=claude-sonnet-4-6

# Optional: override the Claude model used for the per-utterance graph
# extractor.
CHATGRAPH_EXTRACTOR_MODEL=claude-haiku-4-5-20251001

# Optional: OpenAI TTS voice (alloy, echo, fable, onyx, nova, shimmer).
# Defaults to "nova".
CHATGRAPH_TTS_VOICE=

# Optional: override the demo's log level. Takes precedence over the
# -v / -vv command-line flags. Set to WARNING, INFO, or DEBUG.
CHATGRAPH_LOG_LEVEL=
